# ==============================================================================
# Proposal Platform — Environment Variables Configuration Template
# Copy this file to `.env` in the project root to configure your environment.
# ==============================================================================

# --- Frontend (Next.js) ---
# URL of the FastAPI backend service (defaults to http://127.0.0.1:8000)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Database Configuration ---
# PostgreSQL / Supabase connection URL.
# If omitted or left blank, the backend automatically uses the local SQLite database: sqlite:///./mekatron.db
# Example: postgresql://postgres:password@db.supabase.co:5432/postgres
SUPABASE_DB_URL=

# --- AI & LLM Providers (Optional) ---
# If keys are omitted, the platform automatically falls back to its deterministic rule-based engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=

# --- Vector Database (Pinecone — Optional for Semantic Search) ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
